
// int8
int char::MAX = 127;
int char::MIN = -128;

// uint8
int uchar::MAX = 255;
int uchar::MIN = 0;

// int16
int short::MAX = 32767;
int short::MIN = -32768;

// uint16
int ushort::MAX = 65535;
int ushort::MIN = 0;

// int32
int int::MAX = 2147483647;
int int::MIN = -2147483648;

// uint32
int uint::MAX = 4294967295;
int uint::MIN = 0;

// float 
float float::MAX = -50;
float float::MIN = 50;

// double 
double double::MAX = 100;
double double::MIN = -100;

